# =============================================================================
# Model provider selection
# =============================================================================
# The app is provider-agnostic: every LLM and embedding call goes through
# LiteLLM, so switching providers is a CONFIG change, not a code change. A
# provider is selected by the model strings below (ollama/… , azure/… ,
# bedrock/…) plus the matching credentials block.
#
# WHERE a container runs (local Docker vs. a cloud host) is INDEPENDENT of WHICH
# provider it calls. The same image runs locally calling a cloud model, or on a
# cloud host calling a cloud model — only this file changes. See
# docs/specs/model-providers.md.
#
# Consumer variables pick the models — set them all to one provider:
#   EMBEDDING_MODEL          - ingestion: chunk embeddings (also GraphRAG embeddings)
#   EMBEDDING_DIM            - dimension of EMBEDDING_MODEL (GraphRAG lancedb size)
#   GRAPHRAG_CHAT_MODEL      - ingestion: GraphRAG entity/relationship extraction
#   QUERY_REWRITE_MODEL      - online: question -> structured retrieval request
#   ANSWER_GENERATION_MODEL  - online: cited answer over retrieved chunks
#
# Pick ONE of the options below (uncomment it, comment the others).
# -----------------------------------------------------------------------------

# --- Option A: Ollama — local, no cost, no rate limits. Good for development. -
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_API_BASE=http://ollama:11434
GRAPHRAG_CHAT_MODEL=ollama/qwen2.5:3b-instruct
QUERY_REWRITE_MODEL=ollama/qwen2.5:3b-instruct
ANSWER_GENERATION_MODEL=ollama/qwen2.5:3b-instruct
LLM_API_BASE=http://ollama:11434

# --- Option B: Azure OpenAI — cloud provider, called over HTTPS. -------------
# The container can run anywhere; it reaches the API over the network. The
# string after `azure/` is the DEPLOYMENT name from the Azure portal, which may
# differ from the base model name. LiteLLM reads AZURE_API_KEY / AZURE_API_VERSION
# from the env; the endpoint is passed via the *_API_BASE vars.
# EMBEDDING_MODEL=azure/<your-embedding-deployment>
# EMBEDDING_DIM=1536   # text-embedding-3-small=1536, text-embedding-3-large=3072
# EMBEDDING_API_BASE=https://<your-resource>.openai.azure.com/
# GRAPHRAG_CHAT_MODEL=azure/<your-chat-deployment>
# QUERY_REWRITE_MODEL=azure/<your-chat-deployment>
# ANSWER_GENERATION_MODEL=azure/<your-chat-deployment>
# LLM_API_BASE=https://<your-resource>.openai.azure.com/
# AZURE_API_KEY=
# AZURE_API_VERSION=2024-10-21

# --- Option C: AWS Bedrock — cloud provider. ---------------------------------
# Use static access keys when calling from outside AWS; when the container runs
# inside AWS, grant it an IAM role instead and drop the keys (the model string
# is unchanged). Requires Bedrock model access enabled in your AWS account.
# EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
# EMBEDDING_DIM=1024   # Titan Text Embeddings V2 default
# GRAPHRAG_CHAT_MODEL=bedrock/<model-id>
# QUERY_REWRITE_MODEL=bedrock/<model-id>
# ANSWER_GENERATION_MODEL=bedrock/<model-id>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1

# =============================================================================
# Other config (provider-independent)
# =============================================================================

# Embedding batch size — texts sent per embedding request (default 16). Keep
# small for tight cloud rate limits; raise (e.g. 50) for local Ollama or ample quota.
EMBEDDING_BATCH_SIZE=16

# GraphRAG dev cap — max chunks fed to the graph index (unset = whole corpus). A
# full graph build is many LLM calls (extraction + summaries), so cap it low
# (e.g. 15) to stabilize the pipeline cheaply; unset for the final full run.
# GRAPHRAG_MAX_CHUNKS=15

# SEC EDGAR requires a User-Agent identifying the requester (name/project + contact).
# See https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=your-project-name your.email@example.com

# Phoenix (prompt registry + observability). Prompt name/label live in
# seed/prompts/manifest.toml, not here.
PHOENIX_ENDPOINT=http://phoenix:6006

# Retrieval MCP server (search_filings tool). The orchestrator connects here as
# an MCP client. In Docker this is the retrieval stack's container on llm-net.
SEARCH_MCP_URL=http://retrieval-app-1:8001/mcp
