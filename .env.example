# SEC EDGAR requires a User-Agent identifying the requester (name/project + contact).
# See https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=your-project-name your.email@example.com

# Embedding model (ingestion). Provider-agnostic via LiteLLM model string.
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_API_BASE=http://ollama:11434

# Query rewrite (chat/instruct LLM). Provider-agnostic via LiteLLM model string.
QUERY_REWRITE_MODEL=ollama/qwen2.5:3b-instruct
LLM_API_BASE=http://ollama:11434

# Phoenix (prompt registry + observability). Prompt name/label live in
# seed/prompts/manifest.toml, not here.
PHOENIX_ENDPOINT=http://phoenix:6006

# Retrieval MCP server (search_filings tool). The orchestrator connects here as
# an MCP client. In Docker this is the retrieval stack's container on llm-net.
SEARCH_MCP_URL=http://retrieval-app-1:8001/mcp
